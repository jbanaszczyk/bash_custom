# ==[ Customization begin ]============

HISTCONTROL=ignorespace:erasedups
# On exit write the in-memory (deduplicated) history instead of appending to the file
# Skipped for `bash -i -c` (IDE / tool env probes): it does not load history, the trap would empty the file
[[ -z $BASH_EXECUTION_STRING ]] && trap 'history -w; unset HISTFILE' EXIT
export LESS="-NRiFX"
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:---color=16 --bind=home:first,end:last}"
PROJECT_DIR="$HOME"    # target of ~~ - set to the project you work on
RM_TRASH=0    # 1: rm moves to the trash (gio trash, needs gio) - real delete: del
shopt -s autocd

if [ -f ~/.bash_prompt ]; then
    . ~/.bash_prompt
fi

if [ -f ~/.bash_functions ]; then
    . ~/.bash_functions
fi

bind -x '"\e[6~": __hist_widget'
# fzf keys: Ctrl+T insert files, Alt+C cd, Ctrl+R history (Ubuntu package path)
export FZF_CTRL_T_OPTS="${FZF_CTRL_T_OPTS:---walker=file,dir,follow,hidden}"    # Ctrl+T: include hidden
[ -f /usr/share/doc/fzf/examples/key-bindings.bash ] && . /usr/share/doc/fzf/examples/key-bindings.bash

load_completion

# ==[ Customization end ]============
