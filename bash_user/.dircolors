TERM xterm-256color
TERM xterm-88color
TERM xterm-color
TERM xterm-debian
TERM xterm-kitty
TERM msys

# Below are the color init strings for the basic file types. A color init
# string consists of one or more of the following numeric codes:
# Attribute codes:
# 00=none 01=bold 04=underscore 05=blink 07=reverse 08=concealed
# Text color codes:
# 30=black 31=red 32=green 33=yellow 34=blue 35=magenta 36=cyan 37=white
# Background color codes:
# 40=black 41=red 42=green 43=yellow 44=blue 45=magenta 46=cyan 47=white

## ANSI 16 -> Selenized Light (colors come from the terminal palette)
## Colors are for grouping only: one hue per group, no bold-only differences.
## Hues follow the IntelliJ Selenized Light theme where there is an analogy.
#
# group               ANSI     Selenized   IntelliJ analogy
# directories         34       #0072D4     keywords, XML tags, folder icons
# executables         32       #489100     Run action (green)
# symlinks            36       #009C8F     strings / renamed files
# source code (magenta)
# config/data/docs    33       #AD8900     metadata, annotations
# archives, media     31       #D2212D     -
# compiled/logs/tmp   37       #909995     comments, ignored, disabled
# broken symlink      41;30    red bar
# setuid/setgid/cap   43;30    yellow bar
# pipes/sockets/devs  40;33    yellow on bg_1 (#E9E4D0)
# everything else     00       foreground #53676D

NORMAL 00 # no color code at all
#FILE 00 # regular file: use no color at all
RESET 0 # reset to "normal" color
DIR 34 # directory
LINK 36 # symbolic link
MULTIHARDLINK 00 # regular file with more than one link
FIFO 40;33 # pipe
SOCK 40;33 # socket
DOOR 40;33 # door
BLK 40;33 # block device driver
CHR 40;33 # character device driver
ORPHAN 41;30 # symlink to nonexistent file, or non-stat'able file
SETUID 43;30 # file that is setuid (u+s)
SETGID 43;30 # file that is setgid (g+s)
CAPABILITY 43;30 # file with capability
STICKY_OTHER_WRITABLE 34 # dir that is sticky and other-writable (+t,o+w)
OTHER_WRITABLE 34 # dir that is other-writable (o+w) and not sticky
STICKY 34 # dir with the sticky bit set (+t) and not other-writable
# This is for files with execute permission:
EXEC 32

