# Sourced from /root/.bashrc - overwritten by deploy_root.sh; per-host settings go to /root/.bashrc

HISTCONTROL=ignorespace:erasedups
# On exit write the in-memory (deduplicated) history instead of appending to the file
# Skipped for `bash -i -c` (IDE / tool env probes): it does not load history, the trap would empty the file
[[ -z $BASH_EXECUTION_STRING ]] && trap 'history -w; unset HISTFILE' EXIT
export LESS="-NRiFX"
shopt -s autocd

if [ -f ~/.bash_prompt ]; then
    . ~/.bash_prompt
fi

if [ -f ~/.bash_functions ]; then
    . ~/.bash_functions
fi
